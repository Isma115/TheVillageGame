; Engine configuration file.
; This project is the native Godot port of the Pradera prototype.
config_version=5

[application]

config/name="Pradera nativa"
run/main_scene="res://main.tscn"
config/icon="res://assets/house-wood.png"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.094118, 0.141176, 0.113725, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=3
window/size/resizable=true
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.364706, 0.576471, 0.309804, 1)
