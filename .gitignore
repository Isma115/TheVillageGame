# Exportaciones y artefactos de compilación
build/
dist/
out/
release/
*.apk
*.aab
*.pck

# Cachés de herramientas auxiliares
__pycache__/
*.py[cod]
.venv/
venv/
coverage/
.cache/

# Configuración local y secretos
.env
.env.*
!.env.example
*.local

# Archivos temporales
logs/
*.log
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo

# Sistema operativo y editores
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
.idea/
.vscode/

# Artefactos locales de Codex/agentes
.codex/
.agents/
